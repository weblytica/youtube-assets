{
  "manifest_version": 3,
  "name": "Drive Link Toolkit",
  "version": "1.0.0",
  "description": "Extract Google Drive file IDs and generate every useful link variant (share, export, embed, download).",
  "author": "Weblytica",
  "permissions": ["activeTab", "clipboardWrite", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Drive Link Toolkit",
    "default_icon": {
      "16": "icons/inactive-16.png",
      "48": "icons/inactive-48.png",
      "128": "icons/inactive-128.png"
    }
  },
  "icons": {
    "16": "icons/inactive-16.png",
    "48": "icons/inactive-48.png",
    "128": "icons/inactive-128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Open Drive Link Toolkit"
    }
  }
}
