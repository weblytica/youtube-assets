{
    "name": "Dropbox Upload a File from Claude",
    "flow": [
        {
            "id": 1,
            "module": "scenario-service:StartSubscenario",
            "version": 2,
            "metadata": {
                "designer": {
                    "x": 0,
                    "y": 0
                },
                "restore": {},
                "interface": [
                    {
                        "help": "",
                        "name": "Filename",
                        "type": "text",
                        "label": "",
                        "default": "",
                        "required": true,
                        "multiline": false
                    },
                    {
                        "help": "",
                        "name": "Document_Data",
                        "type": "text",
                        "label": "",
                        "default": "",
                        "required": true,
                        "multiline": true
                    }
                ]
            }
        },
        {
            "id": 4,
            "module": "dropbox:uploadLargeFile",
            "version": 5,
            "parameters": {
                "__IMTCONN__": 459063
            },
            "filter": {
                "name": "Filename & Doc Text Exists",
                "conditions": [
                    [
                        {
                            "a": "{{1.Document_Data}}",
                            "o": "exist"
                        },
                        {
                            "a": "{{1.Filename}}",
                            "o": "exist"
                        }
                    ]
                ]
            },
            "mapper": {
                "data": "{{1.Document_Data}}",
                "path": "/GitHub/weblytica-knowledge-repo/claude-project-instructions",
                "filename": "{{formatDate(now; \"YYYY-MM-DD\")}}-{{lower(1.Filename)}}",
                "overwrite": false
            },
            "metadata": {
                "designer": {
                    "x": 300,
                    "y": 0
                },
                "restore": {
                    "expect": {
                        "path": {
                            "mode": "chose"
                        },
                        "overwrite": {
                            "mode": "chose"
                        }
                    },
                    "parameters": {
                        "__IMTCONN__": {
                            "data": {
                                "scoped": "true",
                                "connection": "dropbox"
                            },
                            "label": "Andy's Dropbox connection (andy@weblytica.org)"
                        }
                    }
                },
                "parameters": [
                    {
                        "name": "__IMTCONN__",
                        "type": "account:dropbox",
                        "label": "Connection",
                        "required": true
                    }
                ],
                "expect": [
                    {
                        "name": "path",
                        "type": "folder",
                        "label": "Folder",
                        "required": true
                    },
                    {
                        "name": "filename",
                        "type": "filename",
                        "label": "File Name",
                        "required": true
                    },
                    {
                        "name": "data",
                        "type": "buffer",
                        "label": "Data",
                        "required": true
                    },
                    {
                        "name": "overwrite",
                        "type": "boolean",
                        "label": "Overwrite an existing file",
                        "required": true
                    }
                ]
            }
        },
        {
            "id": 3,
            "module": "scenario-service:ReturnData",
            "version": 2,
            "parameters": {},
            "mapper": {
                "tool_output": "{{`4`}}"
            },
            "metadata": {
                "designer": {
                    "x": 600,
                    "y": 0
                },
                "restore": {},
                "expect": [
                    {
                        "name": "tool_output",
                        "type": "dynamicCollection",
                        "label": ""
                    }
                ]
            }
        }
    ],
    "metadata": {
        "instant": false,
        "version": 1,
        "scenario": {
            "roundtrips": 1,
            "maxErrors": 3,
            "autoCommit": true,
            "autoCommitTriggerLast": true,
            "sequential": false,
            "slots": null,
            "confidential": false,
            "dataloss": false,
            "dlq": false,
            "freshVariables": false
        },
        "designer": {
            "orphans": []
        },
        "zone": "us1.make.com",
        "notes": []
    },
    "io": {
        "input_spec": [
            {
                "help": "",
                "name": "Filename",
                "type": "text",
                "label": "",
                "default": "",
                "required": true,
                "multiline": false
            },
            {
                "help": "",
                "name": "Document_Data",
                "type": "text",
                "label": "",
                "default": "",
                "required": true,
                "multiline": true
            }
        ],
        "output_spec": [
            {
                "help": "",
                "name": "tool_output",
                "type": "dynamicCollection",
                "label": "",
                "default": "",
                "required": false
            }
        ]
    }
}
